---
/**
 * Feuilles de vigne translucides qui traversent la page pendant la navigation.
 * Elles n'apparaissent qu'au défilement et s'effacent 1,4 s après l'arrêt.
 * Désactivé si l'utilisateur demande moins d'animations (voir global.css).
 */
interface Props { count?: number; }
const { count = 6 } = Astro.props;
const leaves = Array.from({ length: count }, (_, i) => i);
---

<div class="leaf-overlay" aria-hidden="true">
  {leaves.map((i) => (
    <div class="leaf" data-leaf={i}>
      <img src="/leaf.svg" alt="" width="136" height="154" />
    </div>
  ))}
</div>

<style>
  .leaf-overlay { position: fixed; inset: 0; z-index: 30; pointer-events: none; overflow: hidden; }
  .leaf {
    position: absolute; left: 0; top: 0;
    width: clamp(80px, 17.6vw, 136px); height: clamp(80px, 17.6vw, 136px);
    color: var(--green);
    opacity: 0;
    transition: opacity 260ms ease;
  }
  .leaf img { width: 100%; height: auto; }
</style>

<script>
  type Spec = { x: number; speed: number; tilt: number; alpha: number; sway: number };
  const specs: Spec[] = [
    { x: 8,  speed: 0.55, tilt: -22, alpha: 0.42, sway: 26 },
    { x: 78, speed: 0.34, tilt: 38,  alpha: 0.34, sway: -34 },
    { x: 30, speed: 0.72, tilt: 12,  alpha: 0.28, sway: 18 },
    { x: 62, speed: 0.46, tilt: -46, alpha: 0.38, sway: 30 },
    { x: 46, speed: 0.28, tilt: 26,  alpha: 0.3,  sway: -22 },
    { x: 88, speed: 0.62, tilt: -14, alpha: 0.36, sway: 24 }
  ];

  const leaves = Array.from(document.querySelectorAll<HTMLElement>(".leaf"));
  let drifting = false;
  let idle: number | undefined;

  function draw() {
    const vh = window.innerHeight;
    const y = window.scrollY;
    leaves.forEach((el, i) => {
      const s = specs[i % specs.length];
      const span = vh * 1.15;
      const start = span * (i / leaves.length);
      const pos = span - ((y * s.speed + start) % span);
      const sway = Math.sin((y * s.speed) / 180) * s.sway;
      el.style.left = s.x + "%";
      el.style.top = pos - vh * 0.07 + "px";
      el.style.transform = `translate(-50%, -50%) translateX(${sway}px) rotate(${s.tilt + sway * 0.6}deg)`;
      el.style.opacity = String(drifting ? s.alpha : 0);
    });
  }

  function onScroll() {
    drifting = true;
    draw();
    window.clearTimeout(idle);
    idle = window.setTimeout(() => { drifting = false; draw(); }, 1400);
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", draw);
  draw();
</script>
