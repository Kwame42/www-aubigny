---
import { univers } from "../data/pages";
---

<div class="univers">
  {univers.map((u) => (
    <a class="univers__tile" href={u.href}>
      <img src={u.img} alt={u.alt} width="1200" height="800" loading="lazy" decoding="async" />
      <span class="univers__veil"></span>
      <span class="univers__arrow" aria-hidden="true">↗</span>
      <span class="univers__label">
        <span class="univers__cat">{u.cat}</span>
        <span class="univers__name">{u.name}</span>
      </span>
    </a>
  ))}
</div>

<style>
  .univers { display: grid; gap: 2px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
  .univers__tile { position: relative; display: block; min-height: 280px; overflow: hidden; background: var(--navy); text-decoration: none; }
  .univers__tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 600ms ease; }
  .univers__tile:hover img { transform: scale(1.04); }
  .univers__veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,32,47,0.12) 40%, rgba(20,32,47,0.82) 100%); }
  .univers__arrow { position: absolute; top: 18px; right: 20px; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,0.55); color: #FFFFFF; font-size: 14px; }
  .univers__label { position: absolute; left: clamp(18px, 4vw, 28px); right: clamp(18px, 4vw, 28px); bottom: clamp(18px, 4vw, 26px); display: flex; flex-direction: column; gap: 8px; color: #FFFFFF; }
  .univers__cat { font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold-pale); }
  .univers__name { font-size: clamp(23px, 6vw, 30px); line-height: 1.15; }
  @media (prefers-reduced-motion: reduce) { .univers__tile img { transition: none; } }
</style>
