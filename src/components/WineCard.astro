---
import type { Wine } from "../data/wines";
interface Props { wine: Wine; }
const { wine } = Astro.props;
const href = wine.page ?? `/vins/${wine.slug}/`;
---

<a class="wine" href={href}>
  <span class="wine__tag">{wine.tag}</span>
  <span class="wine__name">{wine.name}</span>
  <span class="wine__origin">{wine.origin} · {wine.colour}</span>
  <span class="wine__price">{wine.price}</span>
</a>

<style>
  .wine { display: flex; flex-direction: column; gap: 8px; padding: 22px 18px 26px 20px; background: var(--card); border-radius: var(--r-tile); text-decoration: none; color: inherit; }
  .wine:hover { background: var(--card-hi); color: inherit; }
  .wine__tag { font-family: var(--mono); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold); }
  .wine__name { font-size: clamp(19px, 5vw, 22px); line-height: 1.25; }
  .wine__origin { font-size: 14px; color: var(--muted); line-height: 1.5; }
  .wine__price { margin-top: 4px; font-family: var(--mono); font-size: 13px; }
</style>
