---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LeafOverlay from "../components/LeafOverlay.astro";

interface Props {
  title: string;
  description?: string;
  lang?: string;
}
const { title, description = "", lang = "fr" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#contenu" style="position:absolute;left:-9999px">Aller au contenu</a>
    <LeafOverlay />
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
  </body>
</html>
