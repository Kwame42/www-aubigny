---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { frToEn, enToFr, hasEnTranslation } from "../utils/langPaths";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  image?: string;
}
const { title, description = "", lang = "fr", image = "/images/q-nature-1.webp" } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

// hreflang links for FR/EN mirrors with proper path mapping
// Only generate hreflang if the page has a translation
// Skip hreflang for error pages (404, etc.)
let frUrl: string;
let enUrl: string | null = null;
const isErrorPage = Astro.url.pathname === '/404/';

if (!isErrorPage) {
  if (lang === 'fr') {
    frUrl = canonical;
    if (hasEnTranslation(Astro.url.pathname)) {
      const enPath = frToEn(Astro.url.pathname);
      if (Astro.site && enPath) {
        enUrl = new URL(enPath, Astro.site).href;
      } else {
        enUrl = enPath || null;
      }
    }
  } else {
    enUrl = canonical;
    if (hasEnTranslation(Astro.url.pathname)) {
      const frPath = enToFr(Astro.url.pathname);
      if (Astro.site && frPath) {
        frUrl = new URL(frPath, Astro.site).href;
      } else {
        frUrl = frPath || canonical;
      }
    } else {
      frUrl = canonical;
    }
  }
} else {
  frUrl = canonical;
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {!isErrorPage && lang === 'fr' && <link rel="alternate" hreflang="fr" href={canonical} />}
    {!isErrorPage && lang === 'en' && <link rel="alternate" hreflang="en" href={canonical} />}
    {!isErrorPage && lang === 'fr' && enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {!isErrorPage && lang === 'en' && <link rel="alternate" hreflang="fr" href={frUrl} />}
    {!isErrorPage && <link rel="alternate" hreflang="x-default" href={frUrl} />}
    <link rel="icon" href="/images/logo.webp" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {Astro.site && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    <slot name="head" />
    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-1FMdOu-uvArjVyEgvYgvt.js"></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <script src="/panier.js" defer></script>
    <style is:global>
      .skip { position: absolute; left: -9999px; }
      .skip:focus { left: 12px; top: 12px; z-index: 40; background: var(--gold); color: var(--navy); padding: 10px 16px; }
    </style>
  </body>
</html>
