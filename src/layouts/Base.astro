---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  image?: string;
}
const { title, description = "", lang = "fr", image = "/images/q-nature-1.webp" } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

// hreflang links for FR/EN mirrors
const pathWithoutLang = Astro.url.pathname.replace(/^\/(en\/)?/, '/');
const frUrl = Astro.site ? new URL(pathWithoutLang, Astro.site).href : pathWithoutLang;
const enUrl = Astro.site ? new URL(`/en${pathWithoutLang}`, Astro.site).href : `/en${pathWithoutLang}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {lang === 'fr' && <link rel="alternate" hreflang="en" href={enUrl} />}
    {lang === 'en' && <link rel="alternate" hreflang="fr" href={frUrl} />}
    <link rel="alternate" hreflang="x-default" href={frUrl} />
    <link rel="icon" href="/images/blason.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {Astro.site && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <script src="/panier.js" defer></script>
    <style is:global>
      .skip { position: absolute; left: -9999px; }
      .skip:focus { left: 12px; top: 12px; z-index: 40; background: var(--gold); color: var(--navy); padding: 10px 16px; }
    </style>
  </body>
</html>
