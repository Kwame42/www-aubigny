---
import Base from "../../layouts/Base.astro";
---

<Base title="Privacy — Domaine d'Aubigny" description="Privacy policy." lang="en">
  <style>
    .legal { max-width: 900px; margin: 0 auto; padding: clamp(56px, 12vw, 96px) var(--pad-x); }
    .legal__title { font-size: 36px; font-weight: 400; margin-bottom: 48px; }
    .legal h2 { font-size: 20px; font-weight: 500; margin: 32px 0 16px; }
    .legal p { font-size: 15px; line-height: 1.8; color: var(--body); margin-bottom: 12px; }
  </style>

  <section class="legal">
    <h1 class="legal__title">Privacy Policy</h1>
    <p><strong>Last updated:</strong> September 2026</p>

    <h2>1. Data Collection</h2>
    <p>We collect personal information you provide (name, email, address) to process orders and communicate with you.</p>

    <h2>2. Data Use</h2>
    <p>Your data is used only for order fulfillment, shipping, and communications about your purchase. We do not sell or share your data.</p>

    <h2>3. Data Protection</h2>
    <p>We employ standard security measures to protect your personal information from unauthorized access.</p>

    <h2>4. Your Rights</h2>
    <p>You may request access to your data, correction, or deletion by contacting contact@aubigny.wine</p>

    <h2>5. Contact</h2>
    <p>For privacy inquiries, contact: contact@aubigny.wine</p>
  </section>
</Base>
