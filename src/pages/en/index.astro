---
import Base from "../../layouts/Base.astro";
import StatList from "../../components/StatList.astro";
import UniversGrid from "../../components/UniversGrid.astro";
import SchemaOrg from "../../components/SchemaOrg.astro";
import { domainStats, terroirStats, vessels } from "../../data/pages-en";
import { featured, euro } from "../../data/wines-en";
import { organization, getBreadcrumbSchema } from "../../data/schema";

const breadcrumb = getBreadcrumbSchema([
  { name: "Home", url: "https://aubigny.wine/en/" }
]);
---

<Base
  title="Domaine d'Aubigny — Fine Burgundy Wine, Aluze"
  description="The Metairie of Aubigny, cellier of Maizière Abbey since 1132. 206 hectares under organic cultivation. Direct sales from the estate and by mail."
  lang="en"
>
  <SchemaOrg slot="head" schema={[organization, breadcrumb]} />
  <section class="hero">
    <img src="/images/hero-aubigny.webp" alt="Domaine d'Aubigny - Fine Burgundy Wine" width="1400" height="830" loading="eager" decoding="async" fetchpriority="high" />
    <div class="hero__veil"></div>
    <div class="hero__in">
      <img class="hero__blason" src="/images/logo.webp" width="268" height="264" alt="" />
      <p class="eyebrow eyebrow--center eyebrow--light hero__kicker">Fine Burgundy Wine</p>
      <h1 class="hero__title"><span>Domaine</span><span class="hero__italic">d'Aubigny</span></h1>
      <p class="hero__meta">Côte Chalonnaise · Rully · Mercurey · Organic Farming</p>
      <div class="hero__actions">
        <a class="btn" href="/en/wines/">Discover our wines</a>
        <a class="btn btn--outline-light" href="/en/domain/">The estate</a>
      </div>
    </div>
  </section>

  <section class="split">
    <div class="split__text split__text--navy">
      <p class="eyebrow eyebrow--light">The Cistercian Heritage</p>
      <h2>Like Clos Vougeot, <em>the cellier of Cîteaux Abbey</em></h2>
      <p>The Metairie of Aubigny served as the cellier for Maizière Abbey since 1132 — an enclosed vineyard of 20 kilometres of walls protecting 206 hectares of vines, meadows and woods under organic cultivation.</p>
      <p>Direct sales from the estate and by mail. Five cuvées, including two monopolies.</p>
      <StatList stats={domainStats} light />
    </div>
    <img class="split__img" src="/images/p-vignes.webp" alt="Vines and Aluze hamlet at dawn, wooded hillsides in the background" width="1400" height="1000" loading="lazy" decoding="async" />
  </section>

  <section class="cuvees">
    <div class="cuvees__head">
      <p class="eyebrow eyebrow--center eyebrow--light">Our Cuvées</p>
      <h2>The <em>quintessence</em> of Burgundy</h2>
      <p class="cuvees__sub">Hand-harvested, aged in the estate's stone cellars</p>
      <a class="btn btn--sm" href="/en/wines/">Our selection</a>
    </div>
    <div class="cuvees__grid">
      {featured.map((wine) => (
        <a class="tile" href="https://shop.aubigny.wine" target="_blank" rel="noopener noreferrer">
          <span class="tile__tag">{wine.tag}</span>
          <span class="tile__name">{wine.name}</span>
          <span class="tile__sub">{wine.sub}</span>
          <span class="tile__rule"></span>
          <span class="tile__note">{wine.note}</span>
          <span class="tile__price">{euro(wine.price)}<span>ttc</span></span>
          <span class="tile__cta">Order</span>
        </a>
      ))}
    </div>
  </section>

  <section class="split split--reverse">
    <img class="split__img" src="/images/cuverie-4.webp" alt="Terracotta amphorae and oak foudres under the stone vaults" width="1400" height="1000" loading="lazy" decoding="async" />
    <div class="split__text split__text--navy">
      <p class="eyebrow eyebrow--light">The Cellar</p>
      <h2>The art of <em>aging</em></h2>
      <p>Under stone vaults, three vessels of vinification dialogue to express the best of each terroir and each vintage.</p>
      <p>Terracotta amphorae for minerality, oak foudres for complexity, Burgundy barrels for depth.</p>
      <div class="vessels">
        {vessels.map((v) => (
          <div>
            <p class="vessels__name">{v.name}</p>
            <p class="vessels__detail">{v.detail}</p>
          </div>
        ))}
      </div>
      <p class="split__cta"><a class="btn btn--gold-dim btn--sm" href="/en/domain/vinification/">Visit the cellar</a></p>
    </div>
  </section>

  <section class="split split--light">
    <img class="split__img" src="/images/q-nature-104.webp" alt="Path bordered by vines descending to the village, morning light" width="1400" height="1000" loading="lazy" decoding="async" />
    <div class="split__text">
      <p class="eyebrow">The Terroir</p>
      <h2>Land that <em>flourishes</em></h2>
      <p>The soils are clay-limestone across the entire vineyard, between 250 and 330 meters altitude. All 20 hectares are certified organic, with fertilization from compost made on the estate.</p>
      <StatList stats={terroirStats} />
    </div>
  </section>

  <section class="quote">
    <blockquote>
      <p>"Here, in an enchanting setting in the heart of Burgundy, we craft a unique place where tourism, agriculture and gastronomy intertwine."</p>
      <footer>— Domaine d'Aubigny</footer>
    </blockquote>
  </section>

  <section>
    <div class="univers__head">
      <p class="eyebrow eyebrow--center">The Estate</p>
      <h2>Six <em>worlds</em> to explore</h2>
      <p>A complete living place in the heart of the Côte Chalonnaise</p>
    </div>
    <UniversGrid />
  </section>
</Base>

<style>
  .hero { position: relative; min-height: 88vh; display: flex; align-items: center; justify-content: center; overflow: hidden; background: var(--navy); }
  .hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,32,47,0.52) 0%, rgba(20,32,47,0.18) 45%, rgba(20,32,47,0.66) 100%); }
  .hero__in { position: relative; width: 100%; max-width: 900px; padding: clamp(56px, 12vw, 96px) var(--pad-x); text-align: center; color: #FFFFFF; }
  .hero__blason { width: clamp(72px, 16vw, 104px); height: auto; margin: 0 auto 26px; }
  .hero__kicker { justify-content: center; color: var(--gold-pale); margin-bottom: 22px; }
  .hero__kicker::before, .hero__kicker::after { background: rgba(228,216,184,0.6); }
  .hero__title { font-size: clamp(42px, 13vw, 104px); line-height: 0.96; letter-spacing: -0.01em; }
  .hero__title span { display: block; }
  .hero__italic { font-style: italic; color: var(--cream-hi); }
  .hero__meta { margin: 20px 0 0; font-size: clamp(10px, 2.6vw, 12px); letter-spacing: 0.2em; text-transform: uppercase; color: #D6CFC2; line-height: 2.1; }
  .hero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 34px; }
  .hero__actions .btn { flex: 0 1 260px; min-height: 54px; }

  .split { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); background: var(--navy); }
  .split--reverse { direction: ltr; }
  .split__text { padding: clamp(40px, 9vw, 88px) clamp(20px, 5vw, 64px); }
  .split__text--navy { background: var(--navy); color: var(--cream); }
  .split__text h2 { margin: 0 0 26px; font-size: clamp(30px, 8vw, 52px); font-weight: 400; line-height: 1.1; text-wrap: pretty; }
  .split__text--navy h2 em { font-style: italic; color: var(--cream-hi); }
  .split__text h2 em { font-style: italic; color: var(--gold-ink); }
  .split__text p { margin: 0 0 18px; font-size: clamp(15px, 4vw, 17px); line-height: 1.85; color: var(--body); }
  .split__text--navy p { color: var(--on-navy); }
  .split__img { width: 100%; height: 100%; min-height: 300px; object-fit: cover; }
  .split--light { background: var(--bg); }
  .split__cta { margin: 30px 0 0; }
  .vessels { display: grid; gap: 22px 20px; grid-template-columns: repeat(auto-fit, minmax(min(50% - 10px, 140px), 1fr)); border-top: 1px solid var(--navy-line); padding-top: 28px; margin-top: 10px; }
  .vessels__name { margin: 0; font-size: clamp(19px, 5vw, 23px); color: var(--cream); }
  .vessels__detail { margin: 8px 0 0; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--on-navy-muted); }

  .cuvees { background: var(--navy); color: var(--cream); padding: clamp(48px, 11vw, 96px) 0 0; }
  .cuvees__head { max-width: var(--w-wide); margin: 0 auto; padding: 0 var(--pad-x); text-align: center; }
  .cuvees__head h2 { margin: 0 0 18px; font-size: clamp(30px, 8.4vw, 56px); font-weight: 400; line-height: 1.08; }
  .cuvees__head h2 em { font-style: italic; color: var(--cream-hi); }
  .cuvees__sub { margin: 0 0 30px; font-size: clamp(15px, 4vw, 17px); font-style: italic; color: var(--nav-item); }
  .cuvees__grid { max-width: var(--w-wide); margin: clamp(40px, 9vw, 72px) auto 0; padding: 0 var(--pad-x) clamp(48px, 11vw, 96px); display: grid; gap: 1px; background: var(--navy-line); grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .tile { background: var(--navy); padding: clamp(28px, 6vw, 44px) clamp(18px, 4vw, 30px); display: flex; flex-direction: column; align-items: center; text-align: center; color: var(--cream); text-decoration: none; min-height: 100%; }
  .tile:hover { background: var(--navy-soft); color: var(--cream); }
  .tile__tag { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: #A18A52; }
  .tile__name { margin-top: 14px; font-size: clamp(22px, 5.6vw, 27px); line-height: 1.2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: calc(2 * 1.2em); }
  .tile__sub { margin-top: 9px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--on-navy-muted); }
  .tile__rule { width: 34px; height: 1px; background: #3A475A; margin: 20px 0; }
  .tile__note { flex: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; font-size: 15px; line-height: 1.8; color: var(--nav-item); margin: 0; }
  .tile__price { margin-top: 24px; font-size: clamp(24px, 6vw, 30px); line-height: 1; }
  .tile__price span { margin-left: 6px; font-size: 0.34em; letter-spacing: 0.18em; text-transform: uppercase; color: var(--on-navy-muted); }
  .tile__cta { margin-top: 22px; display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 22px; border: 1px solid var(--gold-dim); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }

  .quote { background: var(--navy); color: var(--cream); padding: clamp(56px, 13vw, 120px) var(--pad-x); text-align: center; }
  .quote blockquote { margin: 0 auto; max-width: 900px; }
  .quote p { margin: 0; font-size: clamp(21px, 5.6vw, 38px); font-style: italic; line-height: 1.5; color: #FFFFFF; }
  .quote footer { margin-top: 30px; font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: #A18A52; }

  .univers__head { max-width: var(--w-wide); margin: 0 auto; padding: clamp(48px, 11vw, 88px) var(--pad-x) clamp(30px, 7vw, 48px); text-align: center; }
  .univers__head h2 { margin: 0 0 16px; font-size: clamp(30px, 8.4vw, 54px); font-weight: 400; line-height: 1.08; }
  .univers__head h2 em { font-style: italic; color: var(--gold-ink); }
  .univers__head p { margin: 0; font-size: clamp(15px, 4vw, 17px); font-style: italic; color: var(--muted); }
</style>
