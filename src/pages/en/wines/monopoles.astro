---
import Base from "../../../layouts/Base.astro";
import { monopoles } from "../../../data/cuvees";
import SchemaOrg from "../../../components/SchemaOrg.astro";
import { organization, getBreadcrumbSchema } from "../../../data/schema";

const breadcrumb = getBreadcrumbSchema([
  { name: "Home", url: "https://aubigny.wine/en/" },
  { name: "Our Wines", url: "https://aubigny.wine/en/wines/" },
  { name: "Monopolies", url: "https://aubigny.wine/en/wines/monopoles/" },
]);
---

<Base
  title="Monopolies — Domaine d'Aubigny"
  description="Monopolies — Domaine d'Aubigny. Exclusive estate wines from our private vineyard plots in Aluze, Burgundy France."
  lang="en"
>
  <SchemaOrg slot="head" schema={[organization, breadcrumb]} />

  <article class="monopoles">
    <header class="monopoles__header">
      <div class="monopoles__breadcrumb">
        <a href="/en/wines/" class="link-back">← Our Wines</a>
      </div>
      <h1>Estate Monopolies</h1>
      <p>Two parcels owned exclusively by Domaine d'Aubigny. The unique expression of two distinct terroirs.</p>
    </header>

    <section class="monopoles__body">
      <div class="wines">
        {
          monopoles.map((wine) => (
            <a href={`/en/wines/${wine.slug}/`} class="wine-card wine-card--large">
              <div class="wine-card__head">
                <span class="wine-card__tag">{wine.appellation}</span>
                <span class="wine-card__badge">Monopoly</span>
              </div>
              <h3 class="wine-card__name">{wine.name}</h3>
              <p class="wine-card__desc">
                {wine.color === "rouge" && "Red wine"}
                {wine.color === "blanc" && "White wine"}
                {wine.color === "rose" && "Rosé wine"}
                {wine.type === "monopole" && " exclusive to the estate"}
              </p>
              <span class="wine-card__cta">Learn more →</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="monopoles__info">
      <div class="info-block">
        <h2>What is a monopoly?</h2>
        <p>
          A monopoly (monopole in French) is a vineyard parcel that belongs entirely to a single domaine or producer. These wines represent the purest expression of a specific terroir, crafted entirely at the domaine with complete control over viticulture and winemaking decisions.
        </p>
      </div>
    </section>
  </article>
</Base>

<style>
  .monopoles {
    background: var(--bg);
  }

  .monopoles__header {
    background: var(--navy);
    color: var(--cream);
    padding: clamp(40px, 9vw, 88px) var(--pad-x);
  }

  .monopoles__breadcrumb {
    margin-bottom: 30px;
  }

  .link-back {
    font-size: 14px;
    color: var(--gold);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .link-back:hover {
    text-decoration: underline;
  }

  .monopoles__header h1 {
    margin: 0 0 16px;
    font-size: clamp(32px, 8vw, 52px);
    font-weight: 400;
    line-height: 1.2;
  }

  .monopoles__header p {
    margin: 0;
    font-size: clamp(15px, 4vw, 17px);
    line-height: 1.8;
    max-width: 70ch;
    color: var(--navy-text);
  }

  .monopoles__body {
    max-width: var(--w-wide);
    margin: 0 auto;
    padding: clamp(40px, 9vw, 88px) var(--pad-x);
  }

  .wines {
    display: grid;
    gap: 30px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }

  .wine-card {
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 5vw, 40px);
    background: #FFFFFF;
    border: 1px solid var(--navy-line);
    text-decoration: none;
    color: var(--text);
    transition: all 0.2s;
  }

  .wine-card:hover {
    background: #F9F7F4;
    border-color: var(--gold-dim);
  }

  .wine-card--large {
    min-height: 300px;
  }

  .wine-card__head {
    display: flex;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .wine-card__tag {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-ink);
    font-weight: 500;
  }

  .wine-card__badge {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    background: var(--navy-bg);
    padding: 4px 8px;
    border-radius: 2px;
  }

  .wine-card__name {
    margin: 0 0 12px;
    font-size: clamp(18px, 5vw, 22px);
    font-weight: 400;
    line-height: 1.3;
  }

  .wine-card__desc {
    margin: 0 0 auto;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    flex: 1;
  }

  .wine-card__cta {
    margin-top: 16px;
    font-size: 12px;
    color: var(--gold-ink);
    font-weight: 500;
  }

  .monopoles__info {
    background: var(--navy-bg);
    padding: clamp(40px, 9vw, 88px) var(--pad-x);
  }

  .info-block {
    max-width: 900px;
    margin: 0 auto;
  }

  .info-block h2 {
    margin: 0 0 20px;
    font-size: clamp(24px, 6vw, 32px);
    font-weight: 400;
    line-height: 1.2;
  }

  .info-block p {
    margin: 0;
    font-size: 16px;
    line-height: 1.8;
    color: var(--body);
  }
</style>
