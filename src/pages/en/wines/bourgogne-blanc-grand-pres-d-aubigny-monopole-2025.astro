---
import Base from "../../../layouts/Base.astro";
import SpecTable from "../../../components/SpecTable.astro";
import ProductSchema from "../../../components/ProductSchema.astro";
import { grandPresBlanc2025EN, euro, winesEN } from "../../../data/wines-en";

const { price, stock, tech } = grandPresBlanc2025EN;
---

<Base
  title="Bourgogne Blanc Grand Prés d'Aubigny 2025 — Domaine d'Aubigny"
  description="Grand Prés d'Aubigny 2025, estate monopoly. A wine of character and distinction that showcases the domaine. Chardonnay aged in amphora and oak barrel."
  lang="en"
  image="/images/hero-parcelle.jpg"
>
  <ProductSchema
    name="Bourgogne Blanc Grand Prés d'Aubigny 2025"
    description="Estate monopoly. A wine of character and distinction that showcases the domaine. Chardonnay, direct pressing, aged in amphora and oak barrel."
    price={price}
    image="/images/hero-parcelle.jpg"
    vintage="2025"
    appellation="Bourgogne"
    varietal="Chardonnay"
    inStock={stock}
    productUrl="https://shop.aubigny.wine/en/shop/gpa-2025-bourgogne-blanc-grand-pres-daubigny-2025-monopole-6"
  />
  <section class="fiche-hero">
    <img src="/images/hero-parcelle.jpg" alt="Grand Prés d'Aubigny parcel" width="1600" height="940" loading="eager" decoding="async" fetchpriority="high" />
    <div class="fiche-hero__veil"></div>
    <div class="fiche-hero__in">
      <p class="eyebrow eyebrow--center eyebrow--light">Bourgogne White</p>
      <h1>Grand Prés<br /><em>d'Aubigny</em></h1>
      <p class="fiche-hero__meta">2025 · Chardonnay · Estate Monopoly</p>
    </div>
  </section>

  <article class="article">
    <a class="back" href="/en/wines/">← Our Wines</a>

    <p class="fiche-lead">A wine of character and distinction. This estate monopoly embodies the domaine's identity: Chardonnay from direct pressing, aged in amphora and oak barrel for richness and depth.</p>

    <section class="section">
      <h2>The Domaine's Identity</h2>
      <p>Grand Prés d'Aubigny represents the domaine as a whole—a wine that carries our philosophy in every detail. Produced from our own vineyard, processed with care, aged with patience, and released when it has truly found itself.</p>
      <p>This 2025 vintage confirms what we've worked toward: a wine that speaks to place and intention, without compromise.</p>
    </section>

    <section class="achat">
      <p class="eyebrow eyebrow--light">Purchase</p>
      <p class="achat__price">{euro(price)}<span>per bottle, incl. tax</span></p>
      <p class="achat__fine">75cl bottle · cases of 6 or 12 · shipping to France and EU</p>
      {stock ? (
        <div class="achat__buy">
          <button class="btn achat__add" type="button" data-add="grandPresBlanc2025">Add to cart</button>
        </div>
      ) : (
        <p class="achat__out">Sold out</p>
      )}
    </section>

    <section class="section">
      <h2>Technical Details</h2>
      <SpecTable rows={tech} />
      <p class="fiche-pdf">
        <a href="#fiche-pdf">Technical sheet as PDF</a>
        <span>156 kb</span>
      </p>
    </section>

    <section class="section other">
      <div>
        <p class="other__title">Other Monopolies</p>
        <div class="other__links">
          <a href="/en/wines/bourgogne-rouge-ouche-de-la-maison-monopole/">Ouche de la Maison</a>
          <a href="/en/wines/bourgogne-rouge-ouche-2025/">Ouche Rouge 2025</a>
        </div>
      </div>
      <div>
        <p class="other__title">The 2025 Vintage</p>
        <p class="other__note">Variable season with opportunities for well-tended parcels.</p>
      </div>
    </section>
  </article>
</Base>

<style>
  .fiche-hero {
    position: relative;
    min-height: 52vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--navy);
  }

  .fiche-hero > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fiche-hero__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #14202f6b, #14202f47 40%, #14202fe0);
  }

  .fiche-hero__in {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(44px, 10vw, 88px) var(--pad-x) clamp(32px, 7vw, 56px);
    text-align: center;
    color: #fff;
  }

  .fiche-hero__in h1 {
    font-size: clamp(31px, 8.6vw, 60px);
    line-height: 1.08;
    margin: 0;
  }

  .fiche-hero__in h1 em {
    font-style: italic;
    color: var(--cream-hi);
  }

  .fiche-hero__meta {
    margin: 18px 0 0;
    font-size: clamp(11px, 3vw, 13px);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #d6cfc2;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-ink);
  }

  .eyebrow--center {
    text-align: center;
  }

  .eyebrow--light {
    color: var(--navy-text);
  }

  .article {
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(40px, 9vw, 88px) var(--pad-x);
  }

  .back {
    font-size: 14px;
    color: var(--gold);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 30px;
  }

  .back:hover {
    text-decoration: underline;
  }

  .fiche-lead {
    margin: 0 0 40px;
    font-size: clamp(17px, 4.6vw, 21px);
    line-height: 1.72;
  }

  .section {
    margin-bottom: clamp(40px, 8vw, 60px);
  }

  .section h2 {
    margin: 0 0 20px;
    font-size: clamp(22px, 5vw, 28px);
    font-weight: 400;
    line-height: 1.3;
  }

  .section p {
    margin: 0 0 16px;
    font-size: 16px;
    line-height: 1.85;
    color: var(--body);
  }

  .section p:last-child {
    margin-bottom: 0;
  }

  .achat {
    margin-top: clamp(32px, 7vw, 52px);
    background: var(--navy);
    color: var(--cream);
    padding: clamp(26px, 6vw, 38px);
  }

  .achat__price {
    margin: 0;
    font-size: clamp(34px, 9vw, 48px);
    line-height: 1;
  }

  .achat__price span {
    margin-left: 8px;
    font-size: 0.28em;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--on-navy-muted);
  }

  .achat__fine {
    margin: 14px 0 24px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-navy-muted);
    line-height: 1.9;
  }

  .achat__buy {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: stretch;
  }

  .achat__add {
    flex: 1 1 220px;
  }

  .achat__out {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--on-navy-muted);
  }

  .fiche-pdf {
    margin: 16px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    font-size: 15px;
  }

  .fiche-pdf span {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .other {
    display: grid;
    gap: 26px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }

  .other__title {
    margin: 0 0 14px;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-ink);
  }

  .other__links {
    display: flex;
    flex-direction: column;
    gap: 9px;
    align-items: flex-start;
    font-size: 16px;
  }

  .other__links a {
    color: inherit;
    text-decoration: none;
  }

  .other__links a:hover {
    color: var(--gold);
  }

  .other__note {
    margin: 0 0 12px;
    font-size: 15px;
    line-height: 1.75;
    color: var(--body);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 22px;
    border: 1px solid var(--gold);
    background: transparent;
    color: var(--gold);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn:hover {
    background: var(--gold);
    color: var(--navy);
  }
</style>
