---
import Base from "../../../layouts/Base.astro";
import { wines, featured, groups, euro } from "../../../data/wines-en";

const title = "Our Wines — Domaine d'Aubigny";
const description = "Nine cuvées: Bourgogne, Rully Village, Mercurey 1er Cru, and two estate monopolies. Organic farming since 2015.";
---

<Base {title} {description} lang="en">
  <style>
    .wines { max-width: var(--w-wide); margin: 0 auto; padding: clamp(40px, 9vw, 88px) var(--pad-x); }
    .wines__title { font-size: clamp(36px, 8vw, 48px); font-weight: 400; line-height: 1.1; margin-bottom: 14px; }
    .wines__desc { font-size: clamp(15px, 4vw, 17px); line-height: 1.85; color: var(--muted); margin-bottom: 48px; max-width: 70ch; }
    .wines__group { margin-bottom: 56px; }
    .wines__group-title { font-size: clamp(24px, 6vw, 32px); font-weight: 400; line-height: 1.2; margin-bottom: 8px; }
    .wines__group-desc { font-size: 14px; color: var(--muted); margin-bottom: 24px; }
    .wines__grid { display: grid; gap: 1px; background: var(--navy-line); grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
    .wine-tile { background: #FFFFFF; padding: clamp(28px, 6vw, 44px) clamp(18px, 4vw, 30px); display: flex; flex-direction: column; align-items: center; text-align: center; text-decoration: none; color: inherit; min-height: 100%; }
    .wine-tile:hover { background: #F9F7F4; }
    .wine-tile__tag { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: #A18A52; }
    .wine-tile__name { margin-top: 14px; font-size: clamp(22px, 5.6vw, 27px); line-height: 1.2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: calc(2 * 1.2em); }
    .wine-tile__sub { margin-top: 9px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
    .wine-tile__rule { width: 34px; height: 1px; background: #E8E3DC; margin: 20px 0; }
    .wine-tile__note { flex: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; font-size: 15px; line-height: 1.8; color: var(--body); margin: 0; }
    .wine-tile__price { margin-top: 24px; font-size: clamp(24px, 6vw, 30px); line-height: 1; }
    .wine-tile__price span { margin-left: 6px; font-size: 0.34em; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
    .wine-tile__cta { margin-top: 22px; display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 22px; border: 1px solid var(--gold-dim); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); cursor: pointer; }
  </style>

  <section class="wines">
    <h1 class="wines__title">Our Wines</h1>
    <p class="wines__desc">Nine cuvées from three terroirs: Aluze (monopolies), Rully (Village), and Mercurey (1er Cru). Organic farming, hand-harvested, aged in the cellar.</p>

    {groups.map((group) => (
      <div class="wines__group">
        <h2 class="wines__group-title">{group.title}</h2>
        <p class="wines__group-desc">{group.note}</p>
        <div class="wines__grid">
          {group.wines.map((wine) => (
            <a class="wine-tile" href="https://shop.aubigny.wine" target="_blank" rel="noopener noreferrer">
              <span class="wine-tile__tag">{wine.tag}</span>
              <span class="wine-tile__name">{wine.name}</span>
              <span class="wine-tile__sub">{wine.sub}</span>
              <span class="wine-tile__rule"></span>
              <span class="wine-tile__note">{wine.note}</span>
              <span class="wine-tile__price">{euro(wine.price)}<span>ttc</span></span>
              <span class="wine-tile__cta">Order</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</Base>
