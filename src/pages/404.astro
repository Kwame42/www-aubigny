---
import Base from "../layouts/Base.astro";
---

<Base title="Page introuvable — Maison d'Aubigny" description="Cette page n'existe pas ou a été déplacée.">
  <section class="page-head">
    <div class="page-head__in">
      <p class="eyebrow eyebrow--center eyebrow--light">Erreur 404</p>
      <h1>Page <em>introuvable</em></h1>
      <p class="page-head__lead">Cette page n'existe pas, ou a été déplacée.</p>
    </div>
  </section>

  <article class="article">
    <div class="actions">
      <a class="btn" href="/">Accueil</a>
      <a class="btn btn--outline" href="/vins/">Les vins</a>
    </div>
  </article>
</Base>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
