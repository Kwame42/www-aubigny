          <td>31</td>
        </tr>
        <tr>
          <td><strong>Rully Blanc 2024</strong></td>
          <td>Rully</td>
          <td>霞多丽</td>
          <td>白葡萄酒</td>
          <td>36</td>
        </tr>
        <tr>
          <td><strong>Rully Blanc 2023</strong></td>
          <td>Rully</td>
          <td>霞多丽</td>
          <td>白葡萄酒</td>
          <td>36</td>
        </tr>
        <tr>
