          <td>Aluze</td>
          <td>霞多丽</td>
          <td>白葡萄酒</td>
          <td>27</td>
        </tr>
        <tr>
          <td><strong>Bourgogne Blanc 2022</strong></td>
          <td>Aluze</td>
          <td>霞多丽</td>
          <td>白葡萄酒</td>
          <td>27</td>
        </tr>
        <tr>
          <td><strong>Bourgogne Blanc Grand Prés（垄断）</strong></td>
          <td>Aluze</td>
          <td>霞多丽</td>
          <td>白葡萄酒</td>
          <td>25</td>
        </tr>
        <tr>
          <td><strong>Bourgogne Rouge Ouche de la Maison（垄断）</strong></td>
          <td>Aluze</td>
          <td>黑皮诺</td>
          <td>红葡萄酒</td>
          <td>25</td>
        </tr>
        <tr>
          <td><strong>Rully Village Blanc Les Fromages</strong></td>
          <td>Rully</td>
