---
import Base from "../../layouts/Base.astro";
import { organization, getBreadcrumbSchema } from "../../data/schema";

const title = "Carnet de Vigne — Domaine d'Aubigny";
const description = "Journal de cave et de vigne. Observations saisonnières, vendanges, fermentations, et vie du domaine au fil des mois.";

const breadcrumb = getBreadcrumbSchema([
  { name: "Accueil", url: "https://aubigny.wine/" },
  { name: "Carnet", url: "https://aubigny.wine/carnet/" },
]);

// Articles du carnet (en ordre décroissant de date)
const articles = [
  {
    date: "2026-09-04",
    title: "Vendanges 2026 — L'année de toutes les surprises",
    excerpt: "Vendanges précoces, qualité exceptionnelle, quantités généreuses. L'histoire d'une vigne en parfait équilibre malgré les défis thermiques.",
    href: "/carnet/septembre-2026-vendanges/",
    season: "Vendanges"
  }
];
---

<Base title={title} description={description}>
  <div slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  </div>

  <article class="catalog">
    <header class="catalog__header">
      <h1>Carnet de Vigne</h1>
      <p>Journal de cave et de vigne. Observations saisonnières, vendanges, fermentations, et vie du domaine au fil des mois.</p>
    </header>

    <section class="catalog__body">
      <div class="carnet-list">
        {articles.map((article) => (
          <article class="carnet-item">
            <div class="carnet-item__header">
              <time class="carnet-item__date" datetime={article.date}>
                {new Date(article.date).toLocaleDateString('fr-FR', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
              <span class="carnet-item__season">{article.season}</span>
            </div>
            <h2 class="carnet-item__title">{article.title}</h2>
            <p class="carnet-item__excerpt">{article.excerpt}</p>
            <a href={article.href} class="carnet-item__link">Lire l'article →</a>
          </article>
        ))}
      </div>

      {articles.length === 0 && (
        <div class="carnet-empty">
          <p>Aucun article pour le moment. Rendez-vous bientôt pour les premières observations du carnet.</p>
        </div>
      )}

      <div class="carnet-info">
        <h2>À propos du carnet</h2>
        <p>
          Le carnet de vigne est un journal régulier (minimum 4 entrées par an) où nous partageons nos observations du domaine. Du cycle des vendanges aux étapes de la fermentation, en passant par la floraison et l'élevage, chaque entrée raconte ce qui se passe dans nos vignes et notre cave.
        </p>
        <p>
          C'est un engagement de transparence : vous suivez notre travail tel qu'il se fait, sans filtre, avec ses défis et ses surprises.
        </p>
      </div>
    </section>
  </article>
</Base>

<style>
  .catalog {
    background: var(--bg);
  }

  .catalog__header {
    background: var(--navy);
    color: var(--cream);
    padding: clamp(60px, 13vw, 100px) var(--pad-x);
    text-align: center;
  }

  .catalog__header h1 {
    margin: 0 0 16px;
    font-size: clamp(36px, 10vw, 56px);
    font-weight: 400;
    line-height: 1.2;
  }

  .catalog__header p {
    margin: 0;
    font-size: clamp(16px, 4vw, 18px);
    font-style: italic;
    color: var(--on-navy);
  }

  .catalog__body {
    max-width: var(--w-wide);
    margin: 0 auto;
    padding: clamp(40px, 9vw, 88px) var(--pad-x);
  }

  .carnet-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-bottom: clamp(60px, 12vw, 100px);
  }

  .carnet-item {
    background: var(--navy-bg);
    padding: clamp(24px, 5vw, 40px);
    border-radius: 2px;
    border-left: 3px solid var(--gold);
  }

  .carnet-item__header {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 16px;
  }

  .carnet-item__date {
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }

  .carnet-item__season {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: rgba(228, 168, 25, 0.15);
    color: var(--gold-ink);
    padding: 4px 8px;
    border-radius: 2px;
  }

  .carnet-item__title {
    margin: 0 0 12px;
    font-size: clamp(20px, 5vw, 28px);
    font-weight: 400;
    line-height: 1.3;
  }

  .carnet-item__excerpt {
    margin: 0 0 16px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--body);
  }

  .carnet-item__link {
    font-size: 14px;
    font-weight: 500;
    color: var(--gold-ink);
    text-decoration: none;
    transition: color 0.2s;
  }

  .carnet-item__link:hover {
    color: var(--gold);
  }

  .carnet-empty {
    text-align: center;
    padding: 60px var(--pad-x);
    background: var(--navy-bg);
    border-radius: 2px;
  }

  .carnet-empty p {
    margin: 0;
    font-size: 16px;
    color: var(--muted);
  }

  .carnet-info {
    margin-top: clamp(60px, 12vw, 100px);
    padding: clamp(32px, 6vw, 48px);
    background: rgba(228, 168, 25, 0.08);
    border-radius: 2px;
  }

  .carnet-info h2 {
    margin: 0 0 16px;
    font-size: clamp(22px, 5vw, 28px);
    font-weight: 400;
  }

  .carnet-info p {
    margin: 0 0 16px;
    font-size: 15px;
    line-height: 1.8;
    color: var(--body);
  }

  .carnet-info p:last-child {
    margin-bottom: 0;
  }
</style>
