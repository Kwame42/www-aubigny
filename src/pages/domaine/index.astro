---
import Base from "../../layouts/Base.astro";
import UniversGrid from "../../components/UniversGrid.astro";
import StatList from "../../components/StatList.astro";
import { domainStats } from "../../data/pages";
---

<Base
  title="Le domaine — Maison d'Aubigny"
  description="Vignoble, chai, métairie, compost, archives et visites : les six univers du domaine d'Aubigny, à Aluze en Côte Chalonnaise."
>
  <section class="page-head">
    <div class="page-head__in">
      <p class="eyebrow eyebrow--center eyebrow--light">Le domaine</p>
      <h1>Six <em>univers</em> à découvrir</h1>
      <p class="page-head__lead">Vingt hectares de vigne, 186 hectares de prés et de bois, un chai voûté et une métairie. Un lieu de vie complet au cœur de la Côte Chalonnaise.</p>
    </div>
  </section>

  <UniversGrid />

  <section class="article">
    <StatList stats={domainStats} />
  </section>
</Base>
