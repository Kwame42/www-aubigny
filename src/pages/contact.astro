---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
---

<Base
  title="Nous écrire — Domaine d'Aubigny"
  description="Commande, visite, demande professionnelle ou question sur un millésime : écrivez au domaine d'Aubigny, à Aluze."
>
  <section class="page-head">
    <div class="page-head__in">
      <p class="eyebrow eyebrow--center eyebrow--light">Contact</p>
      <h1>Nous <em>écrire</em></h1>
      <p class="page-head__lead">Pour une commande, une visite, une demande professionnelle ou une question sur un millésime.</p>
    </div>
  </section>

  <article class="article">
    <a class="back" href="/">← Accueil</a>

    <section class="section">
      <h2>Nous contacter</h2>
      <p>Pour une commande, une visite, une question ou une demande professionnelle.</p>

      <div class="contact-methods">
        <div class="contact-method">
          <h3>Téléphone</h3>
          <p>
            <a href="tel:+33385447676" class="btn btn--navy">
              +33 (0)3 85 44 76 76
            </a>
          </p>
        </div>

        <div class="contact-method">
          <h3>Courriel</h3>
          <p>
            <a href="mailto:contact@aubigny.wine" class="btn btn--navy">
              contact@aubigny.wine
            </a>
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>Adresse</h2>
      <p>Domaine d'Aubigny<br />71510 Aluze<br />Côte Chalonnaise, Bourgogne<br />France</p>
    </section>

    <section class="section">
      <h2>Expéditions</h2>
      <p>France et Union européenne, en cartons de 6 ou 12 bouteilles.</p>
      <p>Pour les tarifs de port et les délais, nous contacter directement.</p>
    </section>
  </article>
</Base>

<style>
  .contact-methods {
    display: grid;
    gap: 24px;
    margin: 32px 0;
  }

  .contact-method {
    padding: 20px;
    background: #fef9f5;
    border-radius: 4px;
  }

  .contact-method h3 {
    margin: 0 0 16px;
    font-size: 16px;
    font-weight: 600;
  }

  .contact-method p {
    margin: 0;
  }

  .btn {
    display: inline-block;
    padding: 12px 24px;
    font-size: 16px;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 500;
  }

  .btn--navy {
    background: #1a2838;
    color: white;
  }

  .btn--navy:hover {
    background: #0f1825;
  }
</style>
