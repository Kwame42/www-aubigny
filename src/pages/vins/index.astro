---
import Base from "../../layouts/Base.astro";
import { cuvees } from "../../data/cuvees";
import SchemaOrg from "../../components/SchemaOrg.astro";
import { organization, getBreadcrumbSchema } from "../../data/schema";

const breadcrumb = getBreadcrumbSchema([
  { name: "Accueil", url: "https://aubigny.wine/" },
  { name: "Les vins", url: "https://aubigny.wine/vins/" },
]);

// Grouper par région
const aluzeCuvees = cuvees.filter((c) => c.region === "aluze");
const rullyCuvees = cuvees.filter((c) => c.region === "rully");
const mercureyCuvees = cuvees.filter((c) => c.region === "mercurey");
---

<Base
  title="Les Vins — Domaine d'Aubigny"
  description="Nos cuvées de Bourgogne, Rully et Mercurey. Vente directe à la propriété et par expédition."
>
  <SchemaOrg slot="head" schema={[organization, breadcrumb]} />

  <article class="catalog">
    <header class="catalog__header">
      <h1>Nos Vins</h1>
      <p>Cinq cuvées, dont deux monopoles. Tous les millésimes en vente.</p>
    </header>

    <section class="catalog__body">
      <!-- Aluze & Monopoles -->
      <div class="region">
        <h2 class="region__title">Aluze & Monopoles</h2>
        <div class="wines">
          {
            aluzeCuvees.map((wine) => (
              <div class="wine-group">
                <div class="wine-group__header">
                  <h3 class="wine-group__name">{wine.name}</h3>
                  <span class="wine-group__tag">{wine.appellation}</span>
                  {wine.type === "monopole" && (
                    <span class="wine-group__badge">Monopole</span>
                  )}
                </div>
                <p class="wine-group__desc">{wine.description}</p>
                {wine.millesimes && wine.millesimes.length > 0 && (
                  <div class="millesimes">
                    {wine.millesimes.map((mil) => (
                      <div class="millesime-row">
                        <span class="millesime-row__year">{mil.year}</span>
                        <span class="millesime-row__price">{mil.price}€</span>
                        <span class="millesime-row__status">
                          {mil.inStock ? "En stock" : "Épuisé"}
                        </span>
                        <a href={mil.odooUrl} target="_blank" rel="noopener noreferrer" class="btn btn--sm">
                          Ajouter au panier
                        </a>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </div>

      <!-- Rully -->
      {
        rullyCuvees.length > 0 && (
          <div class="region">
            <h2 class="region__title">Rully</h2>
            <div class="wines">
              {rullyCuvees.map((wine) => (
                <div class="wine-group">
                  <div class="wine-group__header">
                    <h3 class="wine-group__name">{wine.name}</h3>
                    <span class="wine-group__tag">{wine.appellation}</span>
                    {wine.type === "monopole" && (
                      <span class="wine-group__badge">Monopole</span>
                    )}
                  </div>
                  <p class="wine-group__desc">{wine.description}</p>
                  {wine.millesimes && wine.millesimes.length > 0 && (
                    <div class="millesimes">
                      {wine.millesimes.map((mil) => (
                        <div class="millesime-row">
                          <span class="millesime-row__year">{mil.year}</span>
                          <span class="millesime-row__price">{mil.price}€</span>
                          <span class="millesime-row__status">
                            {mil.inStock ? "En stock" : "Épuisé"}
                          </span>
                          <a href={mil.odooUrl} target="_blank" rel="noopener noreferrer" class="btn btn--sm">
                            Ajouter au panier
                          </a>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        )
      }

      <!-- Mercurey -->
      {
        mercureyCuvees.length > 0 && (
          <div class="region">
            <h2 class="region__title">Mercurey</h2>
            <div class="wines">
              {mercureyCuvees.map((wine) => (
                <div class="wine-group">
                  <div class="wine-group__header">
                    <h3 class="wine-group__name">{wine.name}</h3>
                    <span class="wine-group__tag">{wine.appellation}</span>
                    {wine.type === "monopole" && (
                      <span class="wine-group__badge">Monopole</span>
                    )}
                  </div>
                  <p class="wine-group__desc">{wine.description}</p>
                  {wine.millesimes && wine.millesimes.length > 0 && (
                    <div class="millesimes">
                      {wine.millesimes.map((mil) => (
                        <div class="millesime-row">
                          <span class="millesime-row__year">{mil.year}</span>
                          <span class="millesime-row__price">{mil.price}€</span>
                          <span class="millesime-row__status">
                            {mil.inStock ? "En stock" : "Épuisé"}
                          </span>
                          <a href={mil.odooUrl} target="_blank" rel="noopener noreferrer" class="btn btn--sm">
                            Ajouter au panier
                          </a>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        )
      }
    </section>
  </article>
</Base>

<style>
  .catalog {
    background: var(--bg);
  }

  .catalog__header {
    background: var(--navy);
    color: var(--cream);
    padding: clamp(60px, 13vw, 100px) var(--pad-x);
    text-align: center;
  }

  .catalog__header h1 {
    margin: 0 0 16px;
    font-size: clamp(36px, 10vw, 56px);
    font-weight: 400;
    line-height: 1.2;
  }

  .catalog__header p {
    margin: 0;
    font-size: clamp(16px, 4vw, 18px);
    font-style: italic;
    color: var(--on-navy);
  }

  .catalog__body {
    max-width: var(--w-wide);
    margin: 0 auto;
    padding: clamp(40px, 9vw, 88px) var(--pad-x);
  }

  .region {
    margin-bottom: clamp(50px, 10vw, 80px);
  }

  .region:last-child {
    margin-bottom: 0;
  }

  .region__title {
    font-size: clamp(24px, 6vw, 32px);
    font-weight: 400;
    margin: 0 0 30px;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--navy-line);
  }

  .wines {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }

  .wine-card {
    background: var(--navy-bg);
    padding: clamp(24px, 5vw, 32px);
    text-decoration: none;
    color: var(--text);
    border-radius: 2px;
    transition: background 0.2s, transform 0.2s;
  }

  .wine-card:hover {
    background: var(--navy-bg-hover);
    transform: translateY(-2px);
  }

  .wine-card__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
  }

  .wine-card__tag {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .wine-card__badge {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    background: var(--gold-pale);
    color: var(--navy);
    padding: 4px 8px;
    display: inline-block;
  }

  .wine-card__name {
    margin: 0 0 12px;
    font-size: clamp(18px, 5vw, 22px);
    font-weight: 500;
    line-height: 1.3;
  }

  .wine-card__desc {
    margin: 0 0 18px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--body);
  }

  .wine-card__cta {
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 500;
  }


  .wine-group {
    background: var(--navy-bg);
    padding: clamp(24px, 5vw, 32px);
    border-radius: 2px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .wine-group__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 16px;
    flex: none;
  }

  .wine-group__name {
    margin: 0;
    font-size: clamp(18px, 5vw, 22px);
    font-weight: 500;
    line-height: 1.3;
  }

  .wine-group__tag {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    flex: none;
  }

  .wine-group__badge {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    background: var(--gold-pale);
    color: var(--navy);
    padding: 4px 8px;
    display: inline-block;
    flex: none;
  }

  .wine-group__desc {
    margin: 0 0 20px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--body);
    flex: none;
  }

  .millesimes {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: auto;
  }

  .millesime-row {
    display: grid;
    grid-template-columns: 60px 60px 80px 1fr;
    gap: 12px;
    align-items: center;
    padding: 12px;
    min-height: 48px;
    background: rgba(255, 255, 255, 0.03);
    border-left: 2px solid var(--gold);
    font-size: 14px;
  }

  .millesime-row__year {
    font-weight: 500;
    font-size: 16px;
  }

  .millesime-row__price {
    color: var(--gold-ink);
    font-weight: 500;
  }

  .millesime-row__status {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .millesime-row .btn {
    justify-self: end;
  }
</style>
